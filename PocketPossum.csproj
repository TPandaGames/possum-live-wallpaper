<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PocketPossum</AssemblyName>
    <RootNamespace>PocketPossum</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Pocket Possum Screensaver</Product>
    <!-- Single file: web assets are embedded, the WebView2 native loader self-extracts -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*.*" LogicalName="www/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- After publish, produce the .scr (a .scr is just a renamed .exe) -->
  <Target Name="MakeScr" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)PocketPossum.exe" DestinationFiles="$(PublishDir)PocketPossum.scr" />
  </Target>

</Project>
